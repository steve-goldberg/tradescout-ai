# Copy to .env.local and fill in. .env.local is gitignored; this file is not.
# On Railway, set the same names as service variables.

# Gemini API key, used for video analysis and symbol enrichment.
# PUBLIC_ prefix is required: geminiService calls Gemini from the browser, and
# SvelteKit only exposes PUBLIC_-prefixed vars to client code.
# Anything here ships in the client bundle — see issue #3.
# Leave empty locally to fall back to the in-app ApiKeyModal (stored in localStorage).
PUBLIC_GEMINI_API_KEY=

# Chart-IMG, renders the trade charts. Inlined into the client bundle today (issue #3).
CHART_IMG_API_KEY=

# Supadata, fetches YouTube video metadata. Inlined into the client bundle today (issue #3).
SUPADATA_API_KEY=

# Debug logging. NOTE: debugLogger.ts currently reads import.meta.env.VITE_DEBUG,
# which this name does not satisfy — logging is off until that mismatch is fixed.
DEBUG=false
