    {
      "phase": 5,
      "name": "Components Migration",
      "priority": "high",
      "notes": "Convert React components to Svelte 5 using runes",
      "react_to_svelte_patterns": {
        "useState": "$state(initialValue)",
        "useEffect_mount": "$effect(() => { ... })",
        "useEffect_cleanup": "$effect(() => { return () => cleanup() })",
        "useRef_dom": "bind:this={element}",
        "useRef_mutable": "$state(value) without reactivity",
        "props_interface": "interface Props { ... } + let { prop }: Props = $props()",
        "event_handlers": "on:click or onclick={handler}",
        "conditional": "{#if condition}...{/if}",
        "list_render": "{#each items as item}...{/each}",
        "className": "class"
      },
      "steps": [
        {
          "id": "5.1",
          "task": "Migrate VideoUpload component",
          "source": "components/VideoUpload.tsx",
          "target": "src/lib/components/VideoUpload.svelte",
          "react_hooks": ["useState x2"],
          "svelte_conversion": {
            "url_state": "let url = $state('')",
            "isFocused_state": "let isFocused = $state(false)",
            "props": "interface Props { onInputSelected: (input: string | File) => void; isLoading: boolean }",
            "form_submit": "on:submit|preventDefault"
          },
          "status": "pending"
        },
        {
          "id": "5.2",
          "task": "Migrate TradeCard component",
          "source": "components/TradeCard.tsx",
          "target": "src/lib/components/TradeCard.svelte",
          "react_hooks": [],
          "svelte_conversion": {
            "props": "interface Props { idea: TradeIdea }",
            "derived": "Use $derived() for isLong, isShort, accentColor etc"
          },
          "notes": "Stateless component - straightforward conversion",
          "status": "pending"
        },
        {
          "id": "5.3",
          "task": "Migrate MarketAnalysisCard component",
          "source": "components/MarketAnalysisCard.tsx",
          "target": "src/lib/components/MarketAnalysisCard.svelte",
          "react_hooks": [],
          "svelte_conversion": {
            "props": "interface Props { data: MarketAnalysis }",
            "derived": "$derived() for isBullish, isBearish, sentimentColor etc"
          },
          "notes": "Stateless component - straightforward conversion",
          "status": "pending"
        },
        {
          "id": "5.4",
          "task": "Migrate ApiKeyModal component",
          "source": "components/ApiKeyModal.tsx",
          "target": "src/lib/components/ApiKeyModal.svelte",
          "react_hooks": ["useState x2"],
          "svelte_conversion": {
            "apiKey_state": "let apiKey = $state('')",
            "showKey_state": "let showKey = $state(false)",
            "props": "interface Props { isOpen: boolean; onClose: () => void; onSubmit: (key: string) => void }",
            "conditional_render": "{#if isOpen}...{/if}"
          },
          "status": "pending"
        },
        {
          "id": "5.5",
          "task": "Migrate AnalysisLogStream component",
          "source": "components/AnalysisLogStream.tsx",
          "target": "src/lib/components/AnalysisLogStream.svelte",
          "react_hooks": ["useState x4", "useEffect x4", "useRef x2"],
          "complexity": "high",
          "svelte_conversion": {
            "logs_state": "let logs = $state<LogEntry[]>([])",
            "progress_state": "let progress = $state(0)",
            "currentLogIndex_state": "let currentLogIndex = $state(0)",
            "elapsedTime_state": "let elapsedTime = $state(0)",
            "dom_ref": "let logContainer: HTMLDivElement; bind:this={logContainer}",
            "startTime_ref": "const startTime = Date.now() (module scope)",
            "effects": "Multiple $effect() blocks for timers and scroll",
            "cleanup": "$effect returns cleanup function for clearTimeout/clearInterval"
          },
          "notes": "Most complex component - multiple effects with cleanup",
          "status": "pending"
        },
        {
          "id": "5.6",
          "task": "Migrate VideoMetadataCard component",
          "source": "components/VideoMetadataCard.tsx",
          "target": "src/lib/components/VideoMetadataCard.svelte",
          "react_hooks": [],
          "svelte_conversion": {
            "props": "interface Props { metadata: VideoMetadata }"
          },
          "notes": "Stateless component - straightforward conversion",
          "status": "pending"
        }
