    "src/routes/api/metadata/+server.ts",
    "src/app.html",
    "src/app.css",
    "svelte.config.js",
    "vite.config.ts"
  ],
  "critical_patterns": {
    "svelte5_runes": {
      "state": "$state(initialValue) - replaces useState",
      "derived": "$derived(expression) - computed values",
      "effect": "$effect(() => { ... }) - replaces useEffect",
      "props": "let { prop1, prop2 }: Props = $props()",
      "bindable": "$bindable() - for two-way binding props"
    },
    "ssr_safety": {
      "browser_check": "import { browser } from '$app/environment'",
      "pattern": "if (browser) { /* localStorage, document, window */ }"
    },
    "imports": {
      "icons": "import { IconName } from 'lucide-svelte'",
      "lib": "import { thing } from '$lib/path'"
    }
  },
  "risk_areas": [
    {
      "area": "AnalysisLogStream.svelte",
      "risk": "Complex timer/effect management",
      "mitigation": "Test thoroughly, ensure cleanup in $effect return"
    },
    {
      "area": "API Keys in services",
      "risk": "Exposing secrets client-side",
      "mitigation": "Move Chart-IMG and Supadata calls to server endpoints"
    },
    {
      "area": "localStorage SSR",
      "risk": "Server-side rendering errors",
      "mitigation": "Use browser check from $app/environment"
    }
  ],
  "execution_order": [
    "Phase 1: Project Setup",
    "Phase 2: Types (dependency for everything)",
    "Phase 3: Utils (dependency for services)",
    "Phase 4: Services (dependency for components)",
    "Phase 5: Components (can be parallel)",
    "Phase 6: Main Page",
    "Phase 7: Styling",
    "Phase 8: Build Config",
    "Phase 9: Testing"
  ]
}
